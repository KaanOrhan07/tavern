generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ CORE (tüm işletme türleri için ortak) ============

model BusinessType {
  id         String     @id @default(cuid())
  key        String     @unique // ör: "restaurant"
  name       String // ör: "Restoran / Kafe"
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  businesses Business[]
}

enum OrderMode {
  WAITER_ONLY // Sadece garson sipariş girer, müşteri QR menüyü sadece görür
  CUSTOMER_QR // Müşteri QR ile kendi sipariş verir
}

enum Theme {
  LIGHT // Açık tema
  DARK // Koyu tema
}

enum Locale {
  TR
  EN
  ES
  DE
  RU
  AR
}

model Business {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  typeId    String
  type      BusinessType @relation(fields: [typeId], references: [id])
  active    Boolean   @default(true)
  orderMode OrderMode @default(WAITER_ONLY)
  theme     Theme     @default(DARK) // Müşteri QR menüsünün teması
  logoUrl   String?   // İşletme logosu (müşteri menüsü)
  bannerUrl String?   // İşletme banner görseli (müşteri menüsü)
  kitchenCompletedClearMinutes Int @default(30) // Adisyon: tamamlanan kartların ekranda kalma süresi
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users         User[]
  features      BusinessFeature[]
  tables        Table[]
  categories    Category[]
  products      Product[]
  ingredients   Ingredient[]
  orders        Order[]
  payments      Payment[]
  staffRequests StaffRequest[]
  notifications Notification[]
  loyaltyConfig  LoyaltyConfig?
  loyaltyAccounts LoyaltyAccount[]
  auditLogs       AuditLog[]
  idempotencyKeys IdempotencyKey[]
  stockMovements  StockMovement[]
  themeSettings   ThemeSettings?
  localeSettings  BusinessLocaleSettings?
  campaigns       Campaign[]
  customers       Customer[]
  floorAreas      FloorArea[]
  expenses        Expense[]
  menuAnalyses    MenuAnalysis[]
  menuEvents      MenuEvent[]
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Berber / kuaför modülü
  barberSettings BarberSettings?
  services       Service[]
  appointments   Appointment[]
  availabilityExceptions AvailabilityException[]

  // 2.1.0
  businessInfo         BusinessInfo?
  subscription         BusinessSubscription?
  subscriptionPayments PaymentRecord[]
  loyaltyTiers         LoyaltyTier[]
  loyaltyTransactions  LoyaltyTransaction[]

  @@index([organizationId])
}

// Özellik bayrakları — admin panelden işletme başına açılıp kapanır
model BusinessFeature {
  id         String  @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureKey String // ör: "ai_calorie", "ai_forecast", "ai_suggestion", "best_sellers", "kitchen_printer", "staff_requests", "stock"
  enabled    Boolean @default(true)

  @@unique([businessId, featureKey])
}

enum UserRole {
  OWNER
  STAFF
}

model User {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role           UserRole
  name           String
  email          String?  @unique // sadece OWNER için
  passwordHash   String? // sadece OWNER için
  pin            String? // DEPRECATED: düz metin PIN — migration sonrası kaldırılacak
  pinHash        String? // bcrypt hash (STAFF)
  pinFingerprint String? // HMAC ile işletme içi benzersizlik
  active         Boolean  @default(true)
  sessionVersion Int      @default(1)
  locale         Locale   @default(TR)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdOrders         Order[]              @relation("OrderCreatedBy")
  staffRequests         StaffRequest[]
  appointments          Appointment[]        @relation("StaffAppointments")
  passwordResetTokens   PasswordResetToken[]
  stockMovements        StockMovement[]
  organizationMemberships OrganizationMembership[]

  @@unique([businessId, pinFingerprint])
  @@index([businessId, role, active])
}

// ============ RESTORAN/KAFE MODÜLÜ ============

model Table {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String // ör: "Masa 1", "Bahçe 3"
  qrToken     String     @unique @default(uuid()) // QR URL'inde kullanılır
  floorAreaId String?
  floorArea   FloorArea? @relation(fields: [floorAreaId], references: [id], onDelete: SetNull)
  capacity    Int        @default(4)
  shape       String     @default("square")
  posX        Int        @default(0)
  posY        Int        @default(0)
  width       Int        @default(100)
  height      Int        @default(100)
  rotation    Int        @default(0)
  createdAt   DateTime   @default(now())

  orders Order[]

  @@unique([businessId, name])
  @@index([floorAreaId])
}

model Category {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  imageUrl    String?
  icon        String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  products           Product[]
  translations       CategoryTranslation[]
  targetedCampaigns  Campaign[]

  @@unique([businessId, name])
  @@unique([businessId, slug])
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      Locale
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, locale])
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  priceKurus  Int // fiyat kuruş cinsinden (₺125,50 → 12550)
  imageUrl    String
  description String?
  active      Boolean  @default(true)

  // AI kalori/alerjen/diyet çıktısı — işletme onaylayana kadar müşteriye gösterilmez
  calories    Int?
  allergens   String[] @default([])
  vegan       Boolean  @default(false)
  vegetarian  Boolean  @default(false)
  glutenFree  Boolean  @default(false)
  aiApproved  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeItems  RecipeItem[]
  orderItems   OrderItem[]
  variants           ProductVariant[]
  translations       ProductTranslation[]
  targetedCampaigns  Campaign[]

  @@unique([businessId, slug])
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      Locale
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, locale])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String // ör: "Küçük", "Orta", "Büyük"
  priceKurus Int
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)

  orderItems   OrderItem[]
  translations ProductVariantTranslation[]

  @@unique([productId, name])
}

model ProductVariantTranslation {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locale    Locale
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([variantId, locale])
}

model Ingredient {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  unit       String // "g", "kg", "adet", "lt", "ml"
  quantity   Float    @default(0) // mevcut stok miktarı
  createdAt  DateTime @default(now())

  recipeItems RecipeItem[]
  serviceRecipeItems ServiceRecipeItem[]

  @@unique([businessId, name])
}

model RecipeItem {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  amount       Float // ürün başına gereken miktar (ingredient.unit cinsinden)

  @@unique([productId, ingredientId])
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum OrderSource {
  WAITER
  CUSTOMER
}

model Order {
  id          String      @id @default(cuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tableId     String
  table       Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status      OrderStatus @default(OPEN)
  source      OrderSource
  createdById String? // garson girdiyse User id, müşteri girdiyse null
  createdBy   User?       @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  closedAt    DateTime?

  customerPhone        String? // sadakat için normalize telefon
  loyaltyRedeemPoints  Int     @default(0) // kullanılan puan
  loyaltyDiscountKurus Int     @default(0) // uygulanan indirim (kuruş)

  items    OrderItem[]
  payments Payment[]

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName  String // sipariş anındaki ad (snapshot, varyant adı dahil)
  unitKurus    Int // sipariş anındaki birim fiyat (snapshot)
  quantity     Int
  note         String? // müşteri notu (ör. "şekersiz olsun")
  paidQuantity Int             @default(0) // kısmi ödeme: kaç adedi ödendi
  prepared     Boolean         @default(false) // DEPRECATED: status kullan
  preparedAt   DateTime?
  delivered    Boolean         @default(false) // DEPRECATED: status kullan
  status       OrderItemStatus @default(PENDING)
  preparingAt  DateTime?
  readyAt      DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime        @default(now())

  @@index([orderId, status])
}

enum PaymentMethod {
  CASH
  CARD
}

model Payment {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  amountKurus Int
  createdAt   DateTime      @default(now())

  @@index([businessId, createdAt])
}

enum RequestStatus {
  PENDING
  DONE
}

model StaffRequest {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  text        String
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  @@index([businessId, status])
}

enum CampaignDisplayType {
  BANNER
  POPUP
}

enum CampaignTargetType {
  NONE
  PRODUCT
  CATEGORY
}

model Campaign {
  id               String               @id @default(cuid())
  businessId       String
  business         Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  active           Boolean              @default(true)
  displayType      CampaignDisplayType
  targetType       CampaignTargetType   @default(NONE)
  targetProductId  String?
  targetProduct    Product?             @relation(fields: [targetProductId], references: [id], onDelete: SetNull)
  targetCategoryId String?
  targetCategory   Category?            @relation(fields: [targetCategoryId], references: [id], onDelete: SetNull)
  imageUrl         String?
  startsAt         DateTime
  endsAt           DateTime
  displayFrequency String               @default("once_per_session")
  daysOfWeek       Int[]                @default([])
  startTime        String?
  endTime          String?
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  translations CampaignTranslation[]

  @@index([businessId, active, startsAt, endsAt])
}

model CampaignTranslation {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  locale      Locale
  title       String
  description String?
  buttonText  String?

  @@unique([campaignId, locale])
}

enum NotificationType {
  NEW_ORDER
  NEW_REQUEST
  CALL_WAITER
  REQUEST_BILL
  NEW_APPOINTMENT
  APPOINTMENT_APPROVED
  APPOINTMENT_REJECTED
  APPOINTMENT_RESCHEDULE
  APPOINTMENT_REMINDER
  APPOINTMENT_EXPIRED
}

model Notification {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       NotificationType
  message    String
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([businessId, createdAt])
}

// Sadakat ayarları — işletme başına (feature flag ile kontrol)
model LoyaltyConfig {
  businessId               String   @id
  business                 Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pointsPerSpendKurus      Int      @default(100) // harcanan her 1 TL (100 kuruş) = 1 puan
  redeemThresholdPoints    Int      @default(100) // indirim için gereken minimum puan
  redeemDiscountPercent    Int      @default(10) // indirim yüzdesi
  earningMode              String   @default("spend_based") // fixed | spend_based
  fixedPointsPerCompletion Int      @default(10)
  tierSystemEnabled         Boolean  @default(true)
  referralInviterPoints    Int      @default(50)
  referralInviteePoints    Int      @default(25)
  updatedAt                DateTime @updatedAt
}

model LoyaltyAccount {
  id                   String       @id @default(cuid())
  businessId           String
  business             Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phone                String // normalize: 05xxxxxxxxx
  points               Int          @default(0)
  lifetimeEarnedPoints Int          @default(0)
  referralCode         String?      @unique
  referredByPhone      String?
  tierId               String?
  tier                 LoyaltyTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  transactions LoyaltyTransaction[]

  @@unique([businessId, phone])
  @@index([businessId, lifetimeEarnedPoints])
}

// ============ BERBER / KUAFÖR MODÜLÜ ============

model BarberSettings {
  businessId             String   @id
  business               Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slotMinutes            Int      @default(30) // randevu slot aralığı (dakika)
  openTime               String   @default("09:00") // HH:mm
  closeTime              String   @default("20:00") // HH:mm
  responseTimeoutMinutes Int      @default(60) // randevu talebine yanıt süresi
  updatedAt              DateTime @updatedAt
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  priceKurus      Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipeItems  ServiceRecipeItem[]
  appointments Appointment[]

  @@unique([businessId, name])
}

model ServiceRecipeItem {
  id           String     @id @default(cuid())
  serviceId    String
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  amount       Float

  @@unique([serviceId, ingredientId])
}

enum AppointmentStatus {
  PENDING_BUSINESS_APPROVAL
  APPROVED
  REJECTED
  RESCHEDULE_PROPOSED
  RESCHEDULE_ACCEPTED
  COMPLETED
  NO_SHOW
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_BUSINESS
  EXPIRED
  BOOKED // deprecated → APPROVED
  CANCELLED // deprecated → CANCELLED_BY_CUSTOMER
}

model Appointment {
  id                   String            @id @default(cuid())
  businessId           String
  business             Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffId              String
  staff                User              @relation("StaffAppointments", fields: [staffId], references: [id], onDelete: Cascade)
  serviceId            String
  service              Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customerName         String
  customerPhone        String
  customerProfileId    String?
  customerProfile      CustomerProfile?  @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  startAt              DateTime
  endAt                DateTime
  proposedStartAt      DateTime?
  proposedEndAt        DateTime?
  status               AppointmentStatus @default(PENDING_BUSINESS_APPROVAL)
  statusNote           String?
  cancelToken          String            @unique @default(uuid())
  expiresAt            DateTime?
  reminderSentAt       DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  statusHistory AppointmentStatusHistory[]

  @@index([businessId, startAt])
  @@index([staffId, startAt, status])
  @@index([businessId, status])
  @@index([expiresAt])
}

model AppointmentStatusHistory {
  id            String            @id @default(cuid())
  appointmentId String
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  changedById   String?
  changedByRole String?
  note          String?
  createdAt     DateTime          @default(now())

  @@index([appointmentId, createdAt])
}

model AvailabilityException {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffId    String?
  date       DateTime // gün (date-only)
  allDay     Boolean  @default(true)
  startTime  String? // HH:mm
  endTime    String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([businessId, date])
  @@index([staffId, date])
}

// ============ GÜVENLİK / ALTYAPI (2.0) ============

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  CANCEL
  PAYMENT
  STOCK_ADJUSTMENT
  SETTINGS_CHANGE
}

model AuditLog {
  id         String      @id @default(cuid())
  businessId String?
  business   Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  userId     String?
  userName   String?
  userRole   String?
  action     AuditAction
  entityType String
  entityId   String?
  beforeData Json?
  afterData  Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime    @default(now())

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key          String
  endpoint     String
  responseCode Int?
  responseBody Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([businessId, key, endpoint])
  @@index([expiresAt])
}

enum StockMovementType {
  PURCHASE
  ORDER_CONSUMPTION
  ORDER_CANCEL_RETURN
  MANUAL_ADJUSTMENT
  INITIAL_BALANCE
}

model StockMovement {
  id           String            @id @default(cuid())
  businessId   String
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ingredientId String
  type         StockMovementType
  amount       Float
  beforeAmount Float
  afterAmount  Float
  orderId      String?
  userId       String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime          @default(now())

  @@index([businessId, createdAt])
  @@index([ingredientId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
  SALES
  FINANCE
}

model AdminUser {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            AdminRole @default(SUPER_ADMIN)
  active          Boolean   @default(true)
  sessionVersion  Int       @default(1)
  twoFactorSecret String?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ThemeSettings {
  id                String   @id @default(cuid())
  businessId        String   @unique
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  presetKey         String   @default("modern-dark")

  primaryColor      String   @default("#D4A857")
  secondaryColor    String   @default("#141311")
  accentColor       String   @default("#E8C88A")
  backgroundColor   String   @default("#0A0A0A")
  surfaceColor      String   @default("#1B1916")
  textColor         String   @default("#F5EFE0")
  mutedTextColor    String   @default("#B8B0A0")
  borderColor       String   @default("#2B2823")

  headingFont       String   @default("Cormorant Garamond")
  bodyFont          String   @default("DM Sans")

  cardRadius        Int      @default(18)
  buttonRadius      Int      @default(14)
  cardStyle         String   @default("solid")
  categoryCardStyle String   @default("image-overlay")
  productCardStyle  String   @default("horizontal")
  headerStyle       String   @default("centered")

  animationLevel    String   @default("normal")
  introAnimation    String   @default("fade")

  customCssVariables Json?
  themeVersion      Int      @default(1)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model BusinessLocaleSettings {
  id             String   @id @default(cuid())
  businessId     String   @unique
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  defaultLocale  Locale   @default(TR)
  enabledLocales Locale[] @default([TR])
  autoDetect     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Customer {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phone           String
  name            String?
  birthDate       DateTime?
  preferredLocale Locale?
  totalSpendKurus Int       @default(0)
  orderCount      Int       @default(0)
  lastOrderAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([businessId, phone])
  @@index([businessId, lastOrderAt])
}

model FloorArea {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  width      Int      @default(1000)
  height     Int      @default(700)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tables Table[]

  @@unique([businessId, name])
}

enum ExpenseCategory {
  RENT
  SALARY
  SUPPLIER
  UTILITIES
  TAX
  MAINTENANCE
  MARKETING
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  title       String
  amountKurus Int
  expenseDate DateTime
  note        String?
  documentUrl String?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([businessId, expenseDate])
}

enum AnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

model MenuAnalysis {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  inputData   Json
  resultData  Json?
  status      AnalysisStatus @default(PENDING)
  model       String?
  errorCode   String?
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  @@index([businessId, createdAt])
}

enum MenuEventType {
  MENU_VIEW
  CATEGORY_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  REMOVE_FROM_CART
  ORDER_SUBMITTED
}

model MenuEvent {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tableId    String?
  sessionId  String
  type       MenuEventType
  categoryId String?
  productId  String?
  metadata   Json?
  createdAt  DateTime      @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, productId, type, createdAt])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses  Business[]
  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
}

// ============ 2.1.0 — MÜŞTERİ / SADAKAT / ADMIN / İŞLETME BİLGİ ============

model CustomerProfile {
  id              String    @id @default(cuid())
  phone           String    @unique
  phoneVerified   Boolean   @default(false)
  pinHash         String?
  fullName        String?
  birthDate       DateTime?
  preferredLocale String    @default("tr")
  totalVisits     Int       @default(0)
  accountStatus   String    @default("active") // active | suspended | deleted
  forcePinChange  Boolean   @default(false)
  failedPinAttempts Int     @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointments Appointment[]
}

model BusinessInfo {
  businessId   String   @id
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  address      String?
  latitude     Float?
  longitude    Float?
  phone        String?
  instagramUrl String?
  tiktokUrl    String?
  websiteUrl   String?
  description  String?
  updatedAt    DateTime @updatedAt
}

model BusinessSubscription {
  businessId      String    @id
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  paymentDueDay   Int       @default(1)
  paymentStatus   String    @default("current") // current | pending | overdue
  lastPaymentDate DateTime?
  nextPaymentDate DateTime?
  monthlyFeeKurus Int?
  notes           String?
  updatedAt       DateTime  @updatedAt
}

model PaymentRecord {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amountKurus Int
  paidAt      DateTime @default(now())
  recordedBy  String
  method      String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([businessId, paidAt])
}

model LoyaltyTier {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tierName        String
  minLifetimePoints Int      @default(0)
  pointMultiplier Float    @default(1.0)
  rankOrder       Int      @default(0)
  perks           Json?
  createdAt       DateTime @default(now())

  accounts LoyaltyAccount[]

  @@unique([businessId, tierName])
  @@index([businessId, minLifetimePoints])
}

model LoyaltyTransaction {
  id               String         @id @default(cuid())
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  sourceType       String // order_completed | appointment_completed | referral | manual | redeem | birthday
  sourceEntityId   String?
  points           Int
  balanceAfter     Int
  createdAt        DateTime       @default(now())

  @@index([businessId, createdAt])
  @@index([loyaltyAccountId, createdAt])
}
