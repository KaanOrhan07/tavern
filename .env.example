# --- Veritabanı (Supabase) ---
# Supabase Dashboard > Project Settings > Database > Connection string
# DATABASE_URL: "Transaction pooler" (port 6543) — uygulama çalışırken kullanılır
# DIRECT_URL:   "Direct connection" (port 5432) — migration'lar için kullanılır
DATABASE_URL="postgresql://postgres.xxxx:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:SIFRE@db.xxxx.supabase.co:5432/postgres"

# --- Supabase (Realtime + Storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- Auth ---
# Admin girişi için gizli anahtar (uzun rastgele bir değer)
ADMIN_KEY="degistir-bunu-uzun-rastgele-bir-deger"
# JWT imzalama gizli anahtarı (en az 32 karakter rastgele)
AUTH_SECRET="degistir-bunu-en-az-32-karakter-rastgele"
# Personel PIN benzersizlik HMAC anahtarı (yoksa AUTH_SECRET kullanılır)
PIN_HMAC_SECRET="degistir-bunu-ayri-hmac-anahtari"

# Ana admin (ADMIN_KEY) şifresiz girer; alt adminler admin panelinden oluşturulur.
# İşletme şifresi kopyası ve Groq key'i şifrelemek için AYRI anahtar (en az 32 karakter, AUTH_SECRET ile AYNI OLMAMALI):
CREDENTIAL_ENCRYPTION_KEY="degistir-bunu-ayri-en-az-32-karakter-rastgele"

# --- Zamanlayıcı (pg_cron + pg_net → /api/jobs/*, bkz. supabase/pg_cron.sql) ---
CRON_SECRET="degistir-bunu-uzun-rastgele-bir-deger"

# --- SMS (Netgsm) — boşsa SMS gönderilmez ---
# NETGSM_USERCODE=""
# NETGSM_PASSWORD=""
# NETGSM_HEADER="ONAYLI_BASLIK"
# NETGSM_OTP_HEADER=""   # OTP için ayrı başlık/paket kullanılıyorsa
# Test modu: OTP'yi ekranda gösterir ve 000000'ı geçerli sayar. Netgsm canlıya alınınca KALDIRIN.
# CUSTOMER_OTP_DEBUG="1"

# --- E-posta (Resend) — şifre sıfırlama bağlantısı için ---
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Tavern <no-reply@alanadin.com>"

# --- Rate limit (opsiyonel; yoksa process-local Map kullanılır) ---
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AXxxxx"

# --- AI (Groq — ücretsiz, kart gerektirmez: https://console.groq.com/keys) ---
GROQ_API_KEY="gsk_...."
# İsteğe bağlı model override (varsayılan: llama-3.3-70b-versatile)
# GROQ_MODEL="llama-3.3-70b-versatile"

# --- Uygulama ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
